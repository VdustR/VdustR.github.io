{
  "name": "vdustr-github-io",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "check": "astro check",
    "format": "oxfmt --check . && prettier --check \"src/**/*.astro\"",
    "format:write": "oxfmt --write . && prettier --write \"src/**/*.astro\"",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "preview": "astro preview"
  },
  "dependencies": {
    "astro": "7.2.10"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "prettier": "3.8.3",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  }
}
